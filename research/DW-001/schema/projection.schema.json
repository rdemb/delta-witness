{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/rdemb/delta-witness/research/DW-001/schema/projection.schema.json",
  "title": "DeltaWitness DW-001 Baseline Projection v1",
  "description": "Deterministic nested-baseline decisions projected from one integrity-verified DeltaWitness matrix report. Semantic method constraints are enforced by src/deltawitness/dw001.py and its truth-table tests.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "study_id",
    "scenario_id",
    "source",
    "applicability",
    "methods",
    "projection_sha256"
  ],
  "properties": {
    "schema_version": {
      "const": "deltawitness.dw001-projection.v1"
    },
    "study_id": {
      "const": "DW-001"
    },
    "scenario_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "source": {
      "$ref": "#/$defs/source"
    },
    "applicability": {
      "$ref": "#/$defs/applicability"
    },
    "methods": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "$ref": "#/$defs/method"
      }
    },
    "projection_sha256": {
      "$ref": "#/$defs/sha256"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "git_object_id": {
      "type": "string",
      "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
    },
    "state_name": {
      "enum": [
        "base_base",
        "base_candidate",
        "candidate_base",
        "candidate_candidate"
      ]
    },
    "decision": {
      "enum": [
        "accept",
        "reject",
        "indeterminate",
        "not_applicable"
      ]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "report_schema_version",
        "tool_version",
        "report_sha256",
        "witness_sha256",
        "base_sha",
        "head_sha",
        "spec_sha256",
        "observer",
        "observer_id"
      ],
      "properties": {
        "report_schema_version": {
          "const": "0.3"
        },
        "tool_version": {
          "type": "string",
          "minLength": 1
        },
        "report_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "witness_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "base_sha": {
          "$ref": "#/$defs/git_object_id"
        },
        "head_sha": {
          "$ref": "#/$defs/git_object_id"
        },
        "spec_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "observer": {
          "enum": [
            "exit-code-v1",
            "outcome-receipt-v1"
          ]
        },
        "observer_id": {
          "enum": [
            "O0_EXIT_CODE",
            "O1_TYPED_RECEIPT"
          ]
        }
      }
    },
    "state_reason": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "reason"
      ],
      "properties": {
        "state": {
          "$ref": "#/$defs/state_name"
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "applicability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "applicable_states",
        "non_applicable_states"
      ],
      "properties": {
        "applicable_states": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/state_name"
          }
        },
        "non_applicable_states": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/state_reason"
          }
        }
      }
    },
    "state_observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "expected",
        "observed",
        "matched"
      ],
      "properties": {
        "state": {
          "$ref": "#/$defs/state_name"
        },
        "expected": {
          "enum": [
            "pass",
            "fail"
          ]
        },
        "observed": {
          "enum": [
            "pass",
            "fail",
            "error",
            "timeout"
          ]
        },
        "matched": {
          "type": "boolean"
        }
      }
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "claim_id",
        "decision",
        "reason_code",
        "indeterminate_states",
        "contradicted_states",
        "states"
      ],
      "properties": {
        "claim_id": {
          "type": "string",
          "minLength": 1
        },
        "decision": {
          "enum": [
            "accept",
            "reject",
            "indeterminate"
          ]
        },
        "reason_code": {
          "enum": [
            "predicate_satisfied",
            "predicate_contradicted",
            "required_state_indeterminate"
          ]
        },
        "indeterminate_states": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/state_name"
          }
        },
        "contradicted_states": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/state_name"
          }
        },
        "states": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "items": {
            "$ref": "#/$defs/state_observation"
          }
        }
      }
    },
    "method": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method_id",
        "observer_id",
        "combined_method_id",
        "required_states",
        "decision",
        "reason_code",
        "not_applicable_states",
        "claims"
      ],
      "properties": {
        "method_id": {
          "enum": [
            "M0_FINAL",
            "M1_F2P",
            "M2_F2P_P2P",
            "M3_FOUR_STATE"
          ]
        },
        "observer_id": {
          "enum": [
            "O0_EXIT_CODE",
            "O1_TYPED_RECEIPT"
          ]
        },
        "combined_method_id": {
          "type": "string",
          "pattern": "^M(?:0_FINAL|1_F2P|2_F2P_P2P|3_FOUR_STATE)__O(?:0_EXIT_CODE|1_TYPED_RECEIPT)$"
        },
        "required_states": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/state_name"
          }
        },
        "decision": {
          "$ref": "#/$defs/decision"
        },
        "reason_code": {
          "enum": [
            "predicate_satisfied",
            "predicate_contradicted",
            "required_state_indeterminate",
            "required_state_not_applicable"
          ]
        },
        "not_applicable_states": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/state_reason"
          }
        },
        "claims": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/claim"
          }
        }
      }
    }
  }
}
