{
  "$id": "https://github.com/rdemb/delta-witness/research/DW-001/schema/development-pilot-archive.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeltaWitness DW-001 Development Pilot Archive v1",
  "description": "Canonical text-only archive of every JSON document in one verified development mechanism pilot bundle. Embedded document semantics are independently verified by deltawitness.dw001_pilot.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "study_id",
    "pilot_id",
    "partition",
    "plan_sha256",
    "index_semantic_sha256",
    "files",
    "archive_sha256"
  ],
  "properties": {
    "schema_version": {
      "const": "deltawitness.dw001-development-pilot-archive.v1"
    },
    "study_id": {
      "const": "DW-001"
    },
    "pilot_id": {
      "const": "DW-001-DEV-PILOT-V1"
    },
    "partition": {
      "const": "development"
    },
    "plan_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "index_semantic_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "files": {
      "type": "array",
      "minItems": 2,
      "items": {
        "$ref": "#/$defs/file"
      }
    },
    "archive_sha256": {
      "$ref": "#/$defs/sha256"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "relativeJsonPath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$)).+\\.json$"
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "path",
        "document",
        "document_sha256"
      ],
      "properties": {
        "schema_version": {
          "const": "deltawitness.dw001-development-pilot-file.v1"
        },
        "path": {
          "$ref": "#/$defs/relativeJsonPath"
        },
        "document": {},
        "document_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    }
  }
}
