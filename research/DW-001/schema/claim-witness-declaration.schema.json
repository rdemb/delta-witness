{"$id":"https://github.com/rdemb/delta-witness/research/DW-001/schema/claim-witness-declaration.schema.json","$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":false,"description":"Pre-execution operator declaration of exact logical unittest witnesses for one DeltaWitness claim. Declaration validity does not establish semantic claim relevance.","properties":{"adapter":{"additionalProperties":false,"properties":{"id":{"const":"unittest-test-id-v1"},"version":{"const":"1"}},"required":["id","version"],"type":"object"},"aggregate_rule":{"const":"at_least_one_discriminating_and_none_indeterminate"},"claim_id":{"pattern":"^[a-z0-9][a-z0-9._-]{0,127}$","type":"string"},"declaration_sha256":{"pattern":"^[0-9a-f]{64}$","type":"string"},"schema_version":{"const":"deltawitness.claim-witness-declaration.v1"},"selector_commands":{"items":{"additionalProperties":false,"properties":{"command":{"items":{"minLength":1,"type":"string"},"minItems":1,"type":"array"},"selector":{"pattern":"^[A-Za-z_][A-Za-z0-9_]*(\\.[A-Za-z_][A-Za-z0-9_]*){2,}$","type":"string"}},"required":["selector","command"],"type":"object"},"minItems":1,"type":"array"},"selectors":{"items":{"pattern":"^[A-Za-z_][A-Za-z0-9_]*(\\.[A-Za-z_][A-Za-z0-9_]*){2,}$","type":"string"},"minItems":1,"type":"array","uniqueItems":true},"spec_sha256":{"pattern":"^[0-9a-f]{64}$","type":"string"}},"required":["schema_version","spec_sha256","claim_id","adapter","selectors","aggregate_rule","selector_commands","declaration_sha256"],"title":"DeltaWitness Claim Witness Declaration v1","type":"object"}
