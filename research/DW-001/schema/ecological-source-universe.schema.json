{
  "$id": "https://github.com/rdemb/delta-witness/research/DW-001/schema/ecological-source-universe.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeltaWitness DW-001 Ecological Source Universe v1",
  "description": "Design-only initial benchmark-source review. This schema cannot authorize execution, freeze a sampling frame, or select or inspect a holdout.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "study_id",
    "design_id",
    "status",
    "reviewed_main_sha",
    "sources",
    "decisions",
    "execution_authorized",
    "holdout_selected",
    "holdout_inspected",
    "universe_sha256"
  ],
  "properties": {
    "schema_version": {
      "const": "deltawitness.dw001-ecological-source-universe.v1"
    },
    "study_id": {
      "const": "DW-001"
    },
    "design_id": {
      "const": "DW-001-ECOLOGICAL-DESIGN-V1"
    },
    "status": {
      "const": "design_only"
    },
    "reviewed_main_sha": {
      "$ref": "#/$defs/gitSha"
    },
    "sources": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "prefixItems": [
        {
          "allOf": [
            {
              "$ref": "#/$defs/source"
            },
            {
              "properties": {
                "order": {
                  "const": 1
                },
                "source_id": {
                  "const": "swe-bench"
                },
                "repository": {
                  "const": "SWE-bench/SWE-bench"
                },
                "repository_commit_sha": {
                  "const": "ca6e4e0d252f32f8762625b73575d5dee49d0a5a"
                },
                "repository_license_spdx": {
                  "const": "MIT"
                }
              }
            }
          ]
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/source"
            },
            {
              "properties": {
                "order": {
                  "const": 2
                },
                "source_id": {
                  "const": "tdd-bench-verified"
                },
                "repository": {
                  "const": "IBM/TDD-Bench-Verified"
                },
                "repository_commit_sha": {
                  "const": "3df8be066e486789d0b8e0d2865a3a4422b4560f"
                },
                "repository_license_spdx": {
                  "const": "Apache-2.0"
                }
              }
            }
          ]
        }
      ],
      "items": false
    },
    "decisions": {
      "$ref": "#/$defs/decisions"
    },
    "execution_authorized": {
      "const": false
    },
    "holdout_selected": {
      "const": false
    },
    "holdout_inspected": {
      "const": false
    },
    "universe_sha256": {
      "$ref": "#/$defs/sha256"
    }
  },
  "$defs": {
    "gitSha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "nonEmptyStrings": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "order",
        "source_id",
        "source_type",
        "repository",
        "repository_commit_sha",
        "repository_license_spdx",
        "paper_reference",
        "artifact_scope",
        "target_population_relation",
        "dataset_reference_status",
        "license_review_status",
        "authorization_review_status",
        "environment_feasibility",
        "containment_status",
        "execution_authorized",
        "known_biases",
        "blocking_questions"
      ],
      "properties": {
        "order": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2
        },
        "source_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
        },
        "source_type": {
          "const": "public_benchmark_candidate"
        },
        "repository": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
        },
        "repository_commit_sha": {
          "$ref": "#/$defs/gitSha"
        },
        "repository_license_spdx": {
          "enum": [
            "MIT",
            "Apache-2.0"
          ]
        },
        "paper_reference": {
          "type": "string",
          "pattern": "^arXiv:[0-9]{4}\\.[0-9]{5}$"
        },
        "artifact_scope": {
          "$ref": "#/$defs/nonEmptyStrings"
        },
        "target_population_relation": {
          "type": "string",
          "minLength": 1
        },
        "dataset_reference_status": {
          "const": "unpinned"
        },
        "license_review_status": {
          "const": "repository_reviewed_instances_pending"
        },
        "authorization_review_status": {
          "const": "pending"
        },
        "environment_feasibility": {
          "const": "unreviewed"
        },
        "containment_status": {
          "const": "unaccepted"
        },
        "execution_authorized": {
          "const": false
        },
        "known_biases": {
          "$ref": "#/$defs/nonEmptyStrings"
        },
        "blocking_questions": {
          "$ref": "#/$defs/nonEmptyStrings"
        }
      }
    },
    "decisions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_sources_only",
        "target_population_status",
        "sampling_frame_status",
        "unit_of_analysis_status",
        "license_and_authorization_status",
        "review_protocol_status",
        "containment_required",
        "containment_status",
        "precision_target_status",
        "development_holdout_split_status",
        "no_ecological_execution",
        "no_holdout_selection",
        "no_holdout_inspection"
      ],
      "properties": {
        "candidate_sources_only": {
          "const": true
        },
        "target_population_status": {
          "const": "unfrozen"
        },
        "sampling_frame_status": {
          "const": "unfrozen"
        },
        "unit_of_analysis_status": {
          "const": "unfrozen"
        },
        "license_and_authorization_status": {
          "const": "pending"
        },
        "review_protocol_status": {
          "const": "unfrozen"
        },
        "containment_required": {
          "const": true
        },
        "containment_status": {
          "const": "unaccepted"
        },
        "precision_target_status": {
          "const": "unfrozen"
        },
        "development_holdout_split_status": {
          "const": "unfrozen"
        },
        "no_ecological_execution": {
          "const": true
        },
        "no_holdout_selection": {
          "const": true
        },
        "no_holdout_inspection": {
          "const": true
        }
      }
    }
  }
}
