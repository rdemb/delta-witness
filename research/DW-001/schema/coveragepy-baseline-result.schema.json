{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/rdemb/delta-witness/research/DW-001/schema/coveragepy-baseline-result.schema.json",
  "title": "DeltaWitness DW-001 Coverage.py Baseline Result v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "study_id",
    "result_id",
    "partition",
    "plan_sha256",
    "catalog_sha256",
    "mutation_result_semantic_sha256",
    "stdlib_statement_result_semantic_sha256",
    "distribution_manifest_sha256",
    "created_at",
    "runtime",
    "adapter",
    "distribution",
    "configuration",
    "source",
    "profiles",
    "comparison",
    "analysis",
    "policy",
    "cost",
    "semantic_sha256",
    "report_sha256"
  ],
  "properties": {
    "schema_version": {
      "const": "deltawitness.dw001-coveragepy-baseline-result.v1"
    },
    "study_id": {
      "const": "DW-001"
    },
    "result_id": {
      "const": "DW-001-COVERAGEPY-BASELINE-RESULT-V1"
    },
    "partition": {
      "const": "development"
    },
    "plan_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "catalog_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "mutation_result_semantic_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "stdlib_statement_result_semantic_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "distribution_manifest_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "created_at": {
      "type": "string",
      "minLength": 1
    },
    "runtime": {
      "$ref": "#/$defs/runtime"
    },
    "adapter": {
      "$ref": "#/$defs/adapter"
    },
    "distribution": {
      "$ref": "#/$defs/distributionManifest"
    },
    "configuration": {
      "$ref": "#/$defs/rootConfiguration"
    },
    "source": {
      "$ref": "#/$defs/source"
    },
    "profiles": {
      "type": "array",
      "prefixItems": [
        {
          "$ref": "#/$defs/profile"
        },
        {
          "$ref": "#/$defs/profile"
        }
      ],
      "items": false,
      "minItems": 2,
      "maxItems": 2
    },
    "comparison": {
      "$ref": "#/$defs/comparison"
    },
    "analysis": {
      "$ref": "#/$defs/analysis"
    },
    "policy": {
      "$ref": "#/$defs/policy"
    },
    "cost": {
      "$ref": "#/$defs/rootCost"
    },
    "semantic_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "report_sha256": {
      "$ref": "#/$defs/sha256"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "nonnegativeNumber": {
      "type": "number",
      "minimum": 0
    },
    "positiveInteger": {
      "type": "integer",
      "minimum": 1
    },
    "nonnegativeInteger": {
      "type": "integer",
      "minimum": 0
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
    },
    "lineArray": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/positiveInteger"
      },
      "uniqueItems": true
    },
    "arc": {
      "type": "array",
      "prefixItems": [
        {
          "type": "integer"
        },
        {
          "type": "integer"
        }
      ],
      "items": false,
      "minItems": 2,
      "maxItems": 2
    },
    "arcArray": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/arc"
      },
      "uniqueItems": true
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tool_version",
        "python_implementation",
        "python_version",
        "platform_system"
      ],
      "properties": {
        "tool_version": {
          "type": "string",
          "minLength": 1
        },
        "python_implementation": {
          "type": "string",
          "minLength": 1
        },
        "python_version": {
          "type": "string",
          "minLength": 1
        },
        "platform_system": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "adapter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "coverage_receipt_schema_version",
        "coverage_producer",
        "public_api_only",
        "context_strategy"
      ],
      "properties": {
        "id": {
          "const": "coveragepy-public-api-v1"
        },
        "version": {
          "const": "1"
        },
        "coverage_receipt_schema_version": {
          "const": "deltawitness.coveragepy-measurement-receipt.v1"
        },
        "coverage_producer": {
          "const": "deltawitness-coveragepy"
        },
        "public_api_only": {
          "const": true
        },
        "context_strategy": {
          "const": "static-selector-context-v1"
        }
      }
    },
    "distributionManifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "decision",
        "package",
        "version",
        "dependency_scope",
        "selected_artifact",
        "candidate_sdist",
        "source",
        "runtime_contract",
        "manifest_sha256"
      ],
      "properties": {
        "schema_version": {
          "const": "deltawitness.coveragepy-distribution-artifact.v1"
        },
        "decision": {
          "const": "GO"
        },
        "package": {
          "const": "coverage"
        },
        "version": {
          "const": "7.15.2"
        },
        "dependency_scope": {
          "const": "research-extra-only"
        },
        "selected_artifact": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "filename",
            "format",
            "python_tag",
            "abi_tag",
            "platform_tag",
            "sha256",
            "trusted_publishing",
            "sigstore_transparency_entry"
          ],
          "properties": {
            "filename": {
              "const": "coverage-7.15.2-py3-none-any.whl"
            },
            "format": {
              "const": "wheel"
            },
            "python_tag": {
              "const": "py3"
            },
            "abi_tag": {
              "const": "none"
            },
            "platform_tag": {
              "const": "any"
            },
            "sha256": {
              "$ref": "#/$defs/sha256"
            },
            "trusted_publishing": {
              "const": true
            },
            "sigstore_transparency_entry": {
              "$ref": "#/$defs/nonnegativeInteger"
            }
          }
        },
        "candidate_sdist": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "filename",
            "format",
            "sha256",
            "trusted_publishing",
            "sigstore_transparency_entry",
            "selected"
          ],
          "properties": {
            "filename": {
              "const": "coverage-7.15.2.tar.gz"
            },
            "format": {
              "const": "sdist"
            },
            "sha256": {
              "$ref": "#/$defs/sha256"
            },
            "trusted_publishing": {
              "const": true
            },
            "sigstore_transparency_entry": {
              "$ref": "#/$defs/nonnegativeInteger"
            },
            "selected": {
              "const": false
            }
          }
        },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "repository",
            "commit",
            "tag",
            "tag_object",
            "publication_workflow",
            "license",
            "license_file"
          ],
          "properties": {
            "repository": {
              "const": "coveragepy/coveragepy"
            },
            "commit": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            },
            "tag": {
              "const": "7.15.2"
            },
            "tag_object": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            },
            "publication_workflow": {
              "const": ".github/workflows/publish.yml"
            },
            "license": {
              "const": "Apache-2.0"
            },
            "license_file": {
              "const": "LICENSE.txt"
            }
          }
        },
        "runtime_contract": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "minimum_python",
            "supported_delta_witness_pythons",
            "base_runtime_dependency",
            "measurement_network_allowed",
            "persistent_data_file_allowed",
            "ambient_config_allowed",
            "plugins_allowed",
            "auto_start_allowed",
            "subprocess_measurement_allowed",
            "concurrency_modes",
            "public_api_only",
            "selected_tracer"
          ],
          "properties": {
            "minimum_python": {
              "const": "3.10"
            },
            "supported_delta_witness_pythons": {
              "const": [
                "3.11",
                "3.12",
                "3.13",
                "3.14"
              ]
            },
            "base_runtime_dependency": {
              "const": false
            },
            "measurement_network_allowed": {
              "const": false
            },
            "persistent_data_file_allowed": {
              "const": false
            },
            "ambient_config_allowed": {
              "const": false
            },
            "plugins_allowed": {
              "const": false
            },
            "auto_start_allowed": {
              "const": false
            },
            "subprocess_measurement_allowed": {
              "const": false
            },
            "concurrency_modes": {
              "const": []
            },
            "public_api_only": {
              "const": true
            },
            "selected_tracer": {
              "const": "timid-python"
            }
          }
        },
        "manifest_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "rootConfiguration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "data_file",
        "auto_data",
        "timid",
        "branch",
        "config_file",
        "source_dirs",
        "concurrency",
        "check_preimported",
        "context_strategy",
        "messages",
        "plugins",
        "auto_start",
        "subprocess_measurement",
        "network_during_measurement"
      ],
      "properties": {
        "data_file": {
          "const": null
        },
        "auto_data": {
          "const": false
        },
        "timid": {
          "const": true
        },
        "branch": {
          "const": true
        },
        "config_file": {
          "const": false
        },
        "source_dirs": {
          "const": [
            "src"
          ]
        },
        "concurrency": {
          "const": null
        },
        "check_preimported": {
          "const": false
        },
        "context_strategy": {
          "const": "static-selector-context-v1"
        },
        "messages": {
          "const": false
        },
        "plugins": {
          "const": []
        },
        "auto_start": {
          "const": false
        },
        "subprocess_measurement": {
          "const": false
        },
        "network_during_measurement": {
          "const": false
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "path",
        "symbol",
        "source_sha256",
        "ast_sha256",
        "target_id",
        "target_lines"
      ],
      "properties": {
        "source_id": {
          "const": "authorization-predicate-candidate-v1"
        },
        "path": {
          "const": "src/access.py"
        },
        "symbol": {
          "const": "is_admin"
        },
        "source_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "ast_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "target_id": {
          "$ref": "#/$defs/sha256"
        },
        "target_lines": {
          "const": [
            2
          ]
        }
      }
    },
    "selectorCost": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "process_wall_seconds",
        "coverage_wall_seconds",
        "coverage_cpu_seconds",
        "missing_reason"
      ],
      "properties": {
        "status": {
          "enum": [
            "measured",
            "partial"
          ]
        },
        "process_wall_seconds": {
          "$ref": "#/$defs/nonnegativeNumber"
        },
        "coverage_wall_seconds": {
          "oneOf": [
            {
              "$ref": "#/$defs/nonnegativeNumber"
            },
            {
              "type": "null"
            }
          ]
        },
        "coverage_cpu_seconds": {
          "oneOf": [
            {
              "$ref": "#/$defs/nonnegativeNumber"
            },
            {
              "type": "null"
            }
          ]
        },
        "missing_reason": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "aggregateCost": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "command_count",
        "selector_count",
        "process_wall_seconds",
        "coverage_wall_seconds",
        "coverage_cpu_seconds",
        "missing_reason"
      ],
      "properties": {
        "status": {
          "enum": [
            "measured",
            "partial"
          ]
        },
        "command_count": {
          "$ref": "#/$defs/nonnegativeInteger"
        },
        "selector_count": {
          "$ref": "#/$defs/nonnegativeInteger"
        },
        "process_wall_seconds": {
          "$ref": "#/$defs/nonnegativeNumber"
        },
        "coverage_wall_seconds": {
          "oneOf": [
            {
              "$ref": "#/$defs/nonnegativeNumber"
            },
            {
              "type": "null"
            }
          ]
        },
        "coverage_cpu_seconds": {
          "oneOf": [
            {
              "$ref": "#/$defs/nonnegativeNumber"
            },
            {
              "type": "null"
            }
          ]
        },
        "missing_reason": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "rootCost": {
      "allOf": [
        {
          "$ref": "#/$defs/aggregateCost"
        },
        {
          "type": "object",
          "required": [
            "profile_count"
          ],
          "properties": {
            "profile_count": {
              "$ref": "#/$defs/nonnegativeInteger"
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "typedCounts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tests_run",
        "passed",
        "failures",
        "errors",
        "skipped",
        "expected_failures",
        "unexpected_successes"
      ],
      "properties": {
        "tests_run": {
          "$ref": "#/$defs/nonnegativeInteger"
        },
        "passed": {
          "$ref": "#/$defs/nonnegativeInteger"
        },
        "failures": {
          "$ref": "#/$defs/nonnegativeInteger"
        },
        "errors": {
          "$ref": "#/$defs/nonnegativeInteger"
        },
        "skipped": {
          "$ref": "#/$defs/nonnegativeInteger"
        },
        "expected_failures": {
          "$ref": "#/$defs/nonnegativeInteger"
        },
        "unexpected_successes": {
          "$ref": "#/$defs/nonnegativeInteger"
        }
      }
    },
    "receiptDistribution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "manifest_sha256",
        "package",
        "expected_version",
        "observed_distribution_name",
        "observed_distribution_version",
        "observed_module_version"
      ],
      "properties": {
        "manifest_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "package": {
          "const": "coverage"
        },
        "expected_version": {
          "const": "7.15.2"
        },
        "observed_distribution_name": {
          "type": [
            "string",
            "null"
          ]
        },
        "observed_distribution_version": {
          "type": [
            "string",
            "null"
          ]
        },
        "observed_module_version": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "receiptConfiguration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "data_file",
        "auto_data",
        "timid",
        "branch",
        "config_file",
        "source_dirs",
        "concurrency",
        "check_preimported",
        "context",
        "messages",
        "plugins",
        "auto_start",
        "subprocess_measurement",
        "network_during_measurement"
      ],
      "properties": {
        "data_file": {
          "const": null
        },
        "auto_data": {
          "const": false
        },
        "timid": {
          "const": true
        },
        "branch": {
          "const": true
        },
        "config_file": {
          "const": false
        },
        "source_dirs": {
          "const": [
            "src"
          ]
        },
        "concurrency": {
          "const": null
        },
        "check_preimported": {
          "const": false
        },
        "context": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "messages": {
          "const": false
        },
        "plugins": {
          "const": []
        },
        "auto_start": {
          "const": false
        },
        "subprocess_measurement": {
          "const": false
        },
        "network_during_measurement": {
          "const": false
        }
      }
    },
    "branchStat": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "line",
        "total_exits",
        "taken_exits"
      ],
      "properties": {
        "line": {
          "$ref": "#/$defs/positiveInteger"
        },
        "total_exits": {
          "$ref": "#/$defs/nonnegativeInteger"
        },
        "taken_exits": {
          "$ref": "#/$defs/nonnegativeInteger"
        }
      }
    },
    "statementEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "executable",
        "executed",
        "missing",
        "measured_lines",
        "target_executable",
        "target_executed",
        "target_missing"
      ],
      "properties": {
        "executable": {
          "$ref": "#/$defs/lineArray"
        },
        "executed": {
          "$ref": "#/$defs/lineArray"
        },
        "missing": {
          "$ref": "#/$defs/lineArray"
        },
        "measured_lines": {
          "$ref": "#/$defs/lineArray"
        },
        "target_executable": {
          "$ref": "#/$defs/lineArray"
        },
        "target_executed": {
          "$ref": "#/$defs/lineArray"
        },
        "target_missing": {
          "$ref": "#/$defs/lineArray"
        }
      }
    },
    "branchEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "has_arcs",
        "all_arcs",
        "context_arcs",
        "target_arcs",
        "branch_stats",
        "target_branch_stats",
        "missing_branch_count",
        "target_missing_branch_count",
        "missing_branch_arcs",
        "missing_branch_arc_identity_status"
      ],
      "properties": {
        "has_arcs": {
          "const": true
        },
        "all_arcs": {
          "$ref": "#/$defs/arcArray"
        },
        "context_arcs": {
          "$ref": "#/$defs/arcArray"
        },
        "target_arcs": {
          "$ref": "#/$defs/arcArray"
        },
        "branch_stats": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/branchStat"
          }
        },
        "target_branch_stats": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/branchStat"
          }
        },
        "missing_branch_count": {
          "$ref": "#/$defs/nonnegativeInteger"
        },
        "target_missing_branch_count": {
          "$ref": "#/$defs/nonnegativeInteger"
        },
        "missing_branch_arcs": {
          "const": null
        },
        "missing_branch_arc_identity_status": {
          "const": "unavailable-public-api"
        }
      }
    },
    "contextsByLine": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "line",
        "contexts"
      ],
      "properties": {
        "line": {
          "$ref": "#/$defs/positiveInteger"
        },
        "contexts": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "uniqueItems": true
        }
      }
    },
    "contextEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "measured_contexts",
        "contexts_by_lineno",
        "query_context",
        "lines",
        "arcs",
        "partition_valid"
      ],
      "properties": {
        "measured_contexts": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "uniqueItems": true
        },
        "contexts_by_lineno": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/contextsByLine"
          }
        },
        "query_context": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "lines": {
          "$ref": "#/$defs/lineArray"
        },
        "arcs": {
          "$ref": "#/$defs/arcArray"
        },
        "partition_valid": {
          "type": "boolean"
        }
      }
    },
    "coverageReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "binding",
        "producer",
        "distribution",
        "configuration",
        "target",
        "context",
        "measurement_status",
        "measurement_error",
        "measured_files",
        "statement_evidence",
        "branch_evidence",
        "context_evidence",
        "cost",
        "coverage_sha256"
      ],
      "properties": {
        "schema_version": {
          "const": "deltawitness.coveragepy-measurement-receipt.v1"
        },
        "binding": {
          "$ref": "#/$defs/sha256"
        },
        "producer": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "version"
          ],
          "properties": {
            "name": {
              "const": "deltawitness-coveragepy"
            },
            "version": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "distribution": {
          "$ref": "#/$defs/receiptDistribution"
        },
        "configuration": {
          "$ref": "#/$defs/receiptConfiguration"
        },
        "target": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "symbol",
            "source_sha256",
            "target_lines"
          ],
          "properties": {
            "path": {
